{
  "appId": "com.sniffr.app",
  "appName": "Sniffr",
  "webDir": "dist",
  "server": {
    "cleartext": false,
    "allowNavigation": ["sniffrweb.onrender.com"]
  },

  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#F7F9FC"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#F7F9FC",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#F4A7B9"
    }
  }
}
